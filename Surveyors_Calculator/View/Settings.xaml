<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    
    xmlns:local="clr-namespace:Surveyors_Calculator"
    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    
    xmlns:viewmodel="clr-namespace:Surveyors_Calculator.ViewModel"
    
    xmlns:model="clr-namespace:Surveyors_Calculator.Model"
    x:DataType="viewmodel:SettingsViewModel"
    x:Class="Surveyors_Calculator.View.Settings"
    Shell.PresentationMode="Animated">
    <Grid
        ColumnDefinitions="2*,3*">
        <Label
            Grid.Column="0"
            Text="Dark Mode"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
        <Border
            Grid.Column="1"
            HeightRequest="30"
            WidthRequest="60"
            Stroke="{AppThemeBinding Light={StaticResource OffWhite}, Dark={StaticResource DeepGrey}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}}">
            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="15" />
            </Border.StrokeShape>
            <Switch
                Grid.Column="1"
                IsToggled="{Binding IsDarkMode}"
                HorizontalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>